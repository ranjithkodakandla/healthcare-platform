NODE_ENV=development
PORT=3000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL=postgresql://sahayak:sahayak_dev@localhost:5432/sahayak?schema=public

# Local docker-compose Redis
REDIS_URL=redis://localhost:6379

# Optional AI Platform (M8 / E-09). Leave unset → AiPlatformClient always uses fallback.
AI_PLATFORM_ENDPOINT=
AI_TIMEOUT_MS=2000
# NVIDIA NIM (preferred when set) — never commit real keys
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=meta/llama-3.1-8b-instruct

# Firebase Auth — set FIREBASE_PROJECT_ID to enable. Use FIREBASE_SERVICE_ACCOUNT_JSON
# as raw SA JSON, or "ADC" for Application Default Credentials (preferred when org
# policy blocks SA key creation).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=ADC

# Messaging webhooks (optional) — set in staging/prod
WEBHOOK_SHARED_SECRET=

# WhatsApp outbound — Meta Cloud API (preferred) OR Twilio. Leave unset → stub send().
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exotel SMS for IVR reply path. Leave unset → stub send().
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SMS_FROM=
# EXOTEL_SUBDOMAIN=api.exotel.com
